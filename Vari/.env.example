REPLICATE_API_TOKEN=
FAL_KEY=
STABILITY_API_KEY=
GEMINI_API_KEY=

# Cloud storage for deployed web usage.
# In production this app expects R2, so generated images are shared across devices.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=variants

# Optional. If set to a public/custom R2 domain, images are served directly from R2.
# If omitted, the app proxies images through /api/gallery/file?key=...
R2_PUBLIC_URL=
